# Copy this file to .env and fill it in. .env is ignored by git.
#   cp .env.example .env
# Only needed for the tests against the REAL Contabo API (make conformance-real,
# E2E_MODE=real). Normal development and CI use the fake API and need nothing.

# Contabo API credentials (https://my.contabo.com/api/details)
CONTABO_CLIENT_ID=INT-12345678
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=you@example.com
CONTABO_API_PASSWORD=

# A zone in your Contabo account. Tests only write names under
# cm-e2e-<id>.<zone> and cm-conf-<id>.<zone>, and remove them afterwards.
E2E_ZONE=example.com
