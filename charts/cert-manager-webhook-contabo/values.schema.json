{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["groupName", "certManager", "image"],
  "properties": {
    "groupName": {
      "type": "string",
      "description": "API group of the webhook. Must match webhook.groupName in your issuers.",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$",
      "maxLength": 253
    },
    "certManager": {
      "type": "object",
      "required": ["namespace", "serviceAccountName"],
      "properties": {
        "namespace": { "$ref": "#/definitions/dnsLabel" },
        "serviceAccountName": { "$ref": "#/definitions/dnsSubdomain" }
      }
    },
    "secretNames": {
      "type": "array",
      "items": { "$ref": "#/definitions/dnsSubdomain" },
      "uniqueItems": true
    },
    "extraSecretAccess": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["namespace", "secretNames"],
        "additionalProperties": false,
        "properties": {
          "namespace": { "$ref": "#/definitions/dnsLabel" },
          "secretNames": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/dnsSubdomain" }
          }
        }
      }
    },
    "ambientCredentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretName": {
          "anyOf": [{ "const": "" }, { "$ref": "#/definitions/dnsSubdomain" }]
        },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clientID": { "$ref": "#/definitions/secretKey" },
            "clientSecret": { "$ref": "#/definitions/secretKey" },
            "apiUser": { "$ref": "#/definitions/secretKey" },
            "apiPassword": { "$ref": "#/definitions/secretKey" }
          }
        }
      }
    },
    "contabo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiURL": { "type": "string", "pattern": "^(https?://.+)?$" },
        "authURL": { "type": "string", "pattern": "^(https?://.+)?$" },
        "rateLimit": { "type": ["string", "number"] },
        "maxRetries": { "type": ["string", "integer"] },
        "operationTimeout": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m))*$" },
        "requestTimeout": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m))*$" }
      }
    },
    "logLevel": { "type": "integer", "minimum": 0, "maximum": 10 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "securePort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "pki": {
      "type": "object",
      "properties": {
        "caDuration": { "type": "string" },
        "servingCertificateDuration": { "type": "string" }
      }
    },
    "extraEnv": { "type": "array" },
    "imagePullSecrets": { "type": "array" },
    "tolerations": { "type": "array" },
    "topologySpreadConstraints": { "type": "array" },
    "nodeSelector": { "type": "object" },
    "affinity": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" }
  },
  "definitions": {
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "dnsSubdomain": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
      "maxLength": 253
    },
    "secretKey": {
      "type": "string",
      "pattern": "^[-._a-zA-Z0-9]+$",
      "maxLength": 253
    }
  }
}
